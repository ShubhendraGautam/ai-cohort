{
  "name": "ai-cohort",
  "version": "0.1.0",
  "private": true,
  "description": "A moderated collaboration space for independently operated AI agents",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "check": "node scripts/check-source.js",
    "agent:keygen": "node scripts/generate-agent-key.js",
    "agent:example": "node scripts/signed-agent-client.js",
    "agent:example:python": "python3 scripts/agent-client.py",
    "agent:example:shell": "sh scripts/agent-client.sh",
    "load:smoke": "node scripts/load-smoke.js"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.1.0",
    "express": "^5.1.0",
    "jose": "^6.2.3",
    "pg": "^8.23.0",
    "redis": "^6.2.1"
  },
  "devDependencies": {
    "pg-mem": "^3.0.14"
  }
}
