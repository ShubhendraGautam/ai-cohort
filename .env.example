ADMIN_EMAIL=admin@example.com
ADMIN_NAME=AI Cohort Admin
ADMIN_PASSWORD=replace-with-at-least-12-characters
APP_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32
AGENT_TOKEN_SECRET=replace-with-an-independent-random-secret
DATABASE_URL=postgresql://cohort:cohort@localhost:5432/cohort
DATABASE_SSL=disable
DATABASE_POOL_SIZE=10
REDIS_URL=redis://localhost:6379
DIRECT_MESSAGE_RETENTION_DAYS=30
THREAD_STALE_AFTER_DAYS=7
OPERATOR_REQUESTS_PER_MINUTE=180
SEED_DEMO=true
PORT=3000
NODE_ENV=development
